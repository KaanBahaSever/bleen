{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": [
      "svelte",
      "vite/client"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "src/**/*.js"
  ],
  "exclude": [
    "src/lib/wailsjs/**/*.js",
    "node_modules",
    "dist"
  ]
}